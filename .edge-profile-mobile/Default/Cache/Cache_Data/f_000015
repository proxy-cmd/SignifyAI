<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SignifyAI - Realtime Translation</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#c0c1ff",
              "primary-container": "#8083ff",
              secondary: "#4edea3",
              background: "#0c1324",
              "surface-container-lowest": "#070d1f",
              "surface-container-low": "#151b2d",
              "surface-container": "#191f31",
              "surface-container-high": "#23293c",
              "surface-container-highest": "#2e3447",
              "surface-variant": "#2e3447",
              "outline-variant": "#464554",
              "on-surface": "#dce1fb",
              error: "#ffb4ab",
              "error-container": "#93000a"
            },
            fontFamily: {
              headline: ["Space Grotesk"],
              body: ["Inter"],
              label: ["Inter"]
            }
          }
        }
      };
    </script>
    <link rel="stylesheet" href="style.css" />
  </head>
  <body class="bg-background text-on-surface font-body min-h-screen overflow-hidden selection:bg-primary/30">
    <header
      class="fixed top-0 z-50 flex h-16 w-full items-center justify-between border-b border-white/10 bg-[#0c1324]/80 px-3 shadow-[0_8px_32px_0_rgba(2,6,23,0.3)] backdrop-blur-xl sm:px-6"
    >
      <div class="flex min-w-0 items-center gap-3 sm:gap-8">
        <span class="font-headline text-lg font-bold tracking-tighter text-[#6366F1] sm:text-xl">SignifyAI</span>

        <div class="hidden items-center gap-6 md:flex">
          <button
            class="status-badge font-headline text-sm font-semibold tracking-tight text-[#4edea3] transition-colors"
            id="sessionStatusBadge"
            type="button"
          >
            Demo Active
          </button>
          <button
            class="status-badge font-headline text-sm font-medium tracking-tight text-slate-400 transition-colors hover:text-[#c0c1ff]"
            id="speechStatusBadge"
            type="button"
          >
            Speech Enabled
          </button>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-2 sm:gap-4">
        <button
          class="rounded-full border border-white/10 px-3 py-2 text-xs font-medium text-slate-300 transition-all hover:bg-white/5 sm:px-4 sm:text-sm"
          id="stopSessionBtn"
          type="button"
        >
          Pause Demo
        </button>
        <button
          class="rounded-full bg-gradient-to-r from-primary to-primary-container px-3 py-2 text-xs font-bold text-[#1000a9] shadow-lg shadow-primary/20 transition-all hover:scale-[1.02] active:scale-95 sm:px-4 sm:text-sm"
          id="startSessionBtn"
          type="button"
        >
          Demo Running
        </button>
      </div>
    </header>

    <aside
      class="fixed left-0 top-0 z-40 hidden h-full w-64 flex-col border-r border-white/10 bg-[#0c1324] pb-6 pt-20 md:flex"
    >
      <div class="mb-8 px-6">
        <h1 class="font-headline text-lg font-black uppercase tracking-widest text-[#6366F1]">SignifyAI</h1>
        <p class="text-xs font-medium text-slate-500">Premium Precision</p>
      </div>

      <nav class="flex-1 px-3">
        <button class="shell-nav-link is-active" data-nav-mode="translation" type="button">
          <span class="material-symbols-outlined">translate</span>
          <span>Realtime Translation</span>
        </button>
        <button class="shell-nav-link" data-nav-mode="aid" type="button">
          <span class="material-symbols-outlined">emergency</span>
          <span>Emergency Aid</span>
        </button>
        <button class="shell-nav-link" data-nav-mode="eye" type="button">
          <span class="material-symbols-outlined">visibility</span>
          <span>Emergency Eye</span>
        </button>
        <button class="shell-nav-link" data-nav-mode="record" type="button">
          <span class="material-symbols-outlined">videocam</span>
          <span>Record Sign</span>
        </button>
      </nav>

      <div class="space-y-1 border-t border-white/5 px-3 pt-4">
        <div class="mt-6 flex items-center gap-3 px-3">
          <div
            class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full border border-white/10 bg-surface-container-highest"
          >
            <img
              alt="Team Orion"
              class="h-full w-full object-cover"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuABnjm0hHeXBsbTVjgIx4Xku6o09x2WwcVKa5Bwkuk7XaSil61X-4z8Pch_9fDFWCSNG9hIPYw0Kj2aIw1gGvpMIG87U8jLGuWABG1RuzEqtMKpPuoCiY9tsF7JmZgye5kMUIcjVxiz0dYSWLSO8GcsbH-o9ZyvQCFNjFWrBtECPGGwL4tDWdugB9d-c10yIyNVwTDPPqMvJpeGH8OBfD_pQ9vtEVfqDawdJzDr6G-u5fYGw4Ylic7AZ8_WiVc3KFGL0UyQIigAGmqV"
            />
          </div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-on-surface">Made by Team Orion</span>
          </div>
        </div>
      </div>
    </aside>

    <main class="h-screen pt-16 md:pl-64">
      <div class="custom-scrollbar h-full overflow-y-auto pb-24 md:pb-0">
        <section class="scene scene-active translation-scene p-6 lg:p-8" data-scene="translation" id="scene-translation">
          <div class="translation-shell flex flex-col gap-6">
            <div class="translation-stage grid grid-cols-12 gap-6">
              <section
                class="translation-feed-panel relative col-span-12 min-h-[420px] overflow-hidden rounded-xl border border-white/5 bg-surface-container-low xl:col-span-8 xl:min-h-[620px]"
              >
                <div class="absolute inset-0">
                  <img
                    alt="Realtime translation feed"
                    class="h-full w-full object-cover opacity-60 grayscale-[0.2]"
                    id="translationFeedImage"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAQkj99TfHYJAf2kJpqw-CWfRbrj8D6lWgMlmQTXHOXa-pnT76BlvVQxRs7CQt0CFk7SjoLlrCmjMs2MrqDwcDwE1aiLRzv5CrO9oUTIch0uWTd6bb5SViDOdYoFWSR3sRcjmINiE33uL0jDYqHYNIhePo8Exlj9vxMd74YmibNG1pHq7OK-jXbJJuebVo4HCwGEzdoBufGJTDm47eFtziFXDGh14C3Um0lH0ivaJGYeLw_bpRlpdtf1H-Z6N_UmUOdMZLFso5ZUDFR"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#020617] via-transparent to-transparent opacity-50"></div>
                  <svg class="absolute inset-0 h-full w-full opacity-80" viewBox="0 0 800 600">
                    <circle cx="400" cy="300" fill="#6366F1" r="4"></circle>
                    <line stroke="#6366F1" stroke-width="2" x1="400" x2="350" y1="300" y2="400"></line>
                    <line stroke="#6366F1" stroke-width="2" x1="400" x2="450" y1="300" y2="400"></line>
                    <rect
                      fill="none"
                      height="200"
                      stroke="#4edea3"
                      stroke-dasharray="4 4"
                      stroke-width="1"
                      width="160"
                      x="320"
                      y="280"
                    ></rect>
                  </svg>
                </div>

                <div
                  class="absolute left-6 top-6 z-10 flex items-center gap-2 rounded-full border border-[#4edea3]/20 bg-[#0c1324]/60 px-3 py-1.5 backdrop-blur-md"
                >
                  <div class="pulse-emerald h-2 w-2 rounded-full bg-secondary"></div>
                  <span class="font-headline text-[10px] font-bold tracking-widest text-secondary">
                    TRACKING ACTIVE
                  </span>
                </div>

                <div class="absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 items-center gap-4">
                  <button class="translation-overlay-button" data-overlay-action="capture" id="translationCaptureBtn" type="button">
                    <span class="material-symbols-outlined">videocam</span>
                  </button>
                  <button class="translation-overlay-button primary" id="translationSpeechToggle" type="button">
                    <span class="material-symbols-outlined text-3xl" id="translationSpeechIcon">mic</span>
                  </button>
                  <button class="translation-overlay-button" data-overlay-action="focus" id="translationFocusBtn" type="button">
                    <span class="material-symbols-outlined">settings</span>
                  </button>
                </div>
              </section>

              <aside class="translation-sidebar col-span-12 flex flex-col gap-6 xl:col-span-4">
                <article
                  class="translation-card surface-container relative overflow-hidden rounded-xl p-8 ghost-border"
                  data-interactive-card
                >
                  <div class="absolute right-0 top-0 -mr-16 -mt-16 h-32 w-32 bg-primary/5 blur-3xl"></div>
                  <div class="relative flex flex-col gap-6">
                    <div class="flex flex-col gap-4">
                      <div>
                        <span class="font-headline text-[10px] font-bold uppercase tracking-widest text-slate-500">
                          Gesture AI Result
                        </span>
                        <h2
                          class="mt-4 font-headline text-4xl font-bold tracking-tight text-white sm:text-5xl"
                          id="translationResultLabel"
                        >
                          Hello
                        </h2>
                      </div>
                      <div class="flex flex-col items-start sm:items-end">
                        <span class="font-headline text-2xl font-bold text-secondary" id="translationConfidence">
                          98%
                        </span>
                        <span class="text-[10px] text-slate-500">Confidence</span>
                      </div>
                    </div>

                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/5">
                      <div class="h-full rounded-full bg-secondary" id="translationConfidenceBar"></div>
                    </div>

                    <div class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-sm text-primary">auto_awesome</span>
                      <span class="text-xs text-slate-400" id="translationContext">
                        Context: Greeting / Standard American Sign Language
                      </span>
                    </div>
                  </div>
                </article>

                <article class="translation-card surface-container rounded-xl p-8 ghost-border" data-interactive-card>
                  <div class="mb-6">
                    <span class="font-headline text-[10px] font-bold uppercase tracking-widest text-slate-500">
                      Teach AI New Sign
                    </span>
                    <p class="mt-1 text-xs text-slate-400">Map current gesture to a new word or command.</p>
                  </div>

                  <div class="space-y-4">
                    <div class="relative">
                      <label
                        class="absolute -top-2 left-3 bg-surface-container px-2 text-[10px] font-bold uppercase tracking-tighter text-primary"
                        for="teachSignInput"
                      >
                        Label Name
                      </label>
                      <input
                        class="w-full rounded-lg border border-white/10 bg-surface-container-lowest px-4 py-4 text-white outline-none transition-all placeholder:text-slate-600 focus:border-primary/40 focus:ring-1 focus:ring-primary/40"
                        id="teachSignInput"
                        placeholder="e.g. Thank You"
                        type="text"
                      />
                    </div>

                    <button
                      class="flex w-full items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/5 py-4 text-sm font-bold text-on-surface transition-all hover:bg-white/10"
                      id="teachSignSaveBtn"
                      type="button"
                    >
                      <span class="material-symbols-outlined text-sm">save</span>
                      <span>Save Sign</span>
                    </button>
                  </div>
                </article>

                <article class="translation-stream-card flex min-h-[220px] flex-1 flex-col gap-3">
                  <span class="px-2 font-headline text-[10px] font-bold uppercase tracking-widest text-slate-500">
                    Recent Stream
                  </span>
                  <div class="translation-stream-list custom-scrollbar space-y-2" id="translationRecentStream"></div>
                </article>
              </aside>
            </div>

            <footer class="translation-metrics grid grid-cols-2 gap-4 xl:grid-cols-5">
              <article class="translation-metric rounded-xl bg-surface-container-low p-4 ghost-border" data-interactive-card>
                <span class="font-headline text-[10px] font-bold uppercase tracking-tighter text-slate-500">Mode</span>
                <p class="mt-1 text-sm font-medium text-primary" id="translationModeMetric">REALTIME TRANSLATION</p>
              </article>

              <article class="translation-metric rounded-xl bg-surface-container-low p-4 ghost-border" data-interactive-card>
                <span class="font-headline text-[10px] font-bold uppercase tracking-tighter text-slate-500">
                  Hand Status
                </span>
                <p class="mt-1 text-sm font-medium text-secondary" id="translationHandMetric">DUAL DETECTED</p>
              </article>

              <article class="translation-metric rounded-xl bg-surface-container-low p-4 ghost-border" data-interactive-card>
                <span class="font-headline text-[10px] font-bold uppercase tracking-tighter text-slate-500">
                  Face Profile
                </span>
                <p class="mt-1 text-sm font-medium text-on-surface" id="translationFaceMetric">
                  ACTIVE (NORMALIZED)
                </p>
              </article>

              <article class="translation-metric rounded-xl bg-surface-container-low p-4 ghost-border" data-interactive-card>
                <span class="font-headline text-[10px] font-bold uppercase tracking-tighter text-slate-500">
                  Inference Latency
                </span>
                <div class="mt-2 flex items-center gap-2">
                  <span class="text-sm font-medium text-on-surface" id="translationLatencyMetric">12ms</span>
                  <div class="h-1 flex-1 overflow-hidden rounded-full bg-white/5">
                    <div class="h-full bg-primary" id="translationLatencyBar"></div>
                  </div>
                </div>
              </article>

              <article class="translation-metric rounded-xl bg-surface-container-low p-4 ghost-border" data-interactive-card>
                <span class="font-headline text-[10px] font-bold uppercase tracking-tighter text-slate-500">
                  System Load
                </span>
                <div class="mt-2 flex items-center gap-2">
                  <span class="text-sm font-medium text-on-surface" id="translationLoadMetric">32%</span>
                  <div class="h-1 flex-1 overflow-hidden rounded-full bg-white/5">
                    <div class="h-full bg-secondary" id="translationLoadBar"></div>
                  </div>
                </div>
              </article>
            </footer>
          </div>
        </section>
        <section class="scene hidden p-6 lg:p-8" data-scene="aid" id="scene-aid">
          <div class="flex h-full flex-col gap-6 lg:flex-row">
            <section
              class="relative flex-1 overflow-hidden rounded-xl border border-white/5 bg-surface-container-lowest shadow-2xl"
            >
              <img
                alt="Emergency aid feed"
                class="h-full w-full object-cover opacity-80"
                id="aidFeedImage"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC7Gk_YRBz7Dbx8peWM5tpu-GTqFATCE6h9rxtjJ6GShs822u24H_pzkOHh1jTX1Rm_edSDW2-jzVX0BeJpKejeSLCVKjr6ZEuhop96smHGB9fMIS-AqJuKVBuJlCUf2e3qmYJMjOxLkPFRf2smQKIJ0AugbXi1L3O-fN-EkNggyEmDG_hsz_6mmu8if6yE6LRXOmRF7js4p7ZHK4qZAlPISpSfgUdAAIIWzvufz7kpAiFAhwwhvOyTsH9gOQRyCGYhSdoPSuVUSDXS"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent opacity-60"></div>

              <div class="absolute left-6 top-6 flex items-center gap-3">
                <div
                  class="flex items-center gap-2 rounded-full border border-error/30 bg-error-container/80 px-4 py-2 shadow-lg backdrop-blur-md"
                >
                  <span class="h-2 w-2 animate-pulse rounded-full bg-error"></span>
                  <span class="font-headline text-xs font-bold uppercase tracking-widest text-white">
                    Emergency Aid Active
                  </span>
                </div>
                <div
                  class="rounded-full border border-white/10 bg-black/40 px-3 py-2 font-mono text-[10px] text-secondary backdrop-blur-md"
                >
                  CAM_01 // 60FPS // 4K_HDR
                </div>
              </div>

              <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between gap-6">
                <div class="space-y-1">
                  <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Sign Subject Detected</p>
                  <h2 class="font-headline text-2xl font-bold text-white" id="aidSubjectStatus">
                    Analysis in Progress...
                  </h2>
                </div>

                <div class="flex gap-2">
                  <div
                    class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-black/40 backdrop-blur-md"
                  >
                    <span class="material-symbols-outlined text-white">mic_off</span>
                  </div>
                  <div
                    class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-black/40 backdrop-blur-md"
                  >
                    <span class="material-symbols-outlined text-white">settings_overscan</span>
                  </div>
                </div>
              </div>

              <div class="absolute right-0 top-0 m-4 h-24 w-24 rounded-tr-xl border-r-2 border-t-2 border-primary/20"></div>
              <div class="absolute bottom-0 left-0 m-4 h-24 w-24 rounded-bl-xl border-b-2 border-l-2 border-primary/20"></div>
            </section>

            <aside class="flex w-full flex-col gap-6 lg:w-96">
              <article class="overflow-hidden rounded-xl border border-error/20 bg-surface-container shadow-2xl" data-interactive-card>
                <div class="flex items-center justify-between bg-error-container p-4">
                  <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-white" style="font-variation-settings: 'FILL' 1;">
                      warning
                    </span>
                    <h2 class="font-headline text-lg font-extrabold tracking-tight text-white">EMERGENCY ALERT</h2>
                  </div>
                  <span class="text-[10px] font-bold tracking-widest text-white/70">URGENT</span>
                </div>

                <div class="space-y-6 p-6">
                  <div class="flex items-start justify-between gap-6">
                    <div>
                      <p class="mb-1 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">
                        Detected Intent
                      </p>
                      <p class="font-headline text-3xl font-bold text-error" id="aidAlertIntent">SEVERE PAIN</p>
                    </div>
                    <div class="text-right">
                      <p class="mb-1 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Confidence</p>
                      <p class="font-headline text-xl font-medium text-secondary" id="aidAlertConfidence">99.8%</p>
                    </div>
                  </div>

                  <button
                    class="w-full rounded-lg bg-error py-4 text-sm font-extrabold uppercase tracking-widest text-[#690005] shadow-lg shadow-error/20 transition-all hover:brightness-110 active:scale-[0.98]"
                    id="aidAcknowledgeBtn"
                    type="button"
                  >
                    Acknowledge Alert
                  </button>
                </div>
              </article>

              <article class="glass-panel flex-1 rounded-xl p-6" data-interactive-card>
                <div class="mb-6 flex items-center justify-between">
                  <h3 class="font-headline font-bold tracking-tight text-white">QUICK ASSISTANCE</h3>
                  <span class="material-symbols-outlined text-sm text-slate-500">grid_view</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <button
                    class="aid-action-button"
                    data-aid-confidence="91.4%"
                    data-aid-intent="Need Water"
                    data-aid-status="Hydration assistance requested."
                    type="button"
                  >
                    <span class="material-symbols-outlined mb-2 block text-primary">water_drop</span>
                    <span class="text-xs font-bold text-slate-300">Need Water</span>
                  </button>
                  <button
                    class="aid-action-button"
                    data-aid-confidence="90.8%"
                    data-aid-intent="Need Food"
                    data-aid-status="Meal request elevated to the care queue."
                    type="button"
                  >
                    <span class="material-symbols-outlined mb-2 block text-primary">restaurant</span>
                    <span class="text-xs font-bold text-slate-300">Need Food</span>
                  </button>
                  <button
                    class="aid-action-button"
                    data-aid-confidence="89.6%"
                    data-aid-intent="Call Family"
                    data-aid-status="Family contact request queued."
                    type="button"
                  >
                    <span class="material-symbols-outlined mb-2 block text-primary">family_restroom</span>
                    <span class="text-xs font-bold text-slate-300">Call Family</span>
                  </button>
                  <button
                    class="aid-action-button"
                    data-aid-confidence="95.1%"
                    data-aid-intent="Hospital Help"
                    data-aid-status="Hospital assistance lane activated."
                    type="button"
                  >
                    <span class="material-symbols-outlined mb-2 block text-primary">local_hospital</span>
                    <span class="text-xs font-bold text-slate-300">Hospital Help</span>
                  </button>
                  <button
                    class="aid-action-button emergency col-span-2"
                    data-aid-confidence="99.9%"
                    data-aid-intent="Cannot Breathe"
                    data-aid-status="Respiratory distress protocol is active."
                    type="button"
                  >
                    <div>
                      <span
                        class="material-symbols-outlined mb-2 block text-error"
                        style="font-variation-settings: 'FILL' 1;"
                      >
                        air
                      </span>
                      <span class="text-xs font-bold uppercase tracking-wider text-error">Cannot Breathe</span>
                    </div>
                    <span class="material-symbols-outlined text-error/40">chevron_right</span>
                  </button>
                </div>

                <div class="mt-4 grid grid-cols-2 gap-3">
                  <button
                    class="aid-response-button yes"
                    data-aid-confidence="93.2%"
                    data-aid-intent="YES"
                    data-aid-status="Affirmative confirmation received."
                    type="button"
                  >
                    Yes
                  </button>
                  <button
                    class="aid-response-button no"
                    data-aid-confidence="92.4%"
                    data-aid-intent="NO"
                    data-aid-status="Negative response received."
                    type="button"
                  >
                    No
                  </button>
                </div>
              </article>

              <article class="glass-panel flex items-center justify-between rounded-xl p-4" data-interactive-card>
                <div class="flex items-center gap-3">
                  <div class="relative">
                    <div class="h-3 w-3 rounded-full bg-secondary"></div>
                    <div class="absolute inset-0 h-3 w-3 animate-ping rounded-full bg-secondary opacity-75"></div>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 leading-none">Latency</p>
                    <p class="font-headline text-sm font-bold text-white" id="aidLatency">12ms</p>
                  </div>
                </div>

                <div class="h-8 w-px bg-white/10"></div>

                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">
                    videocam
                  </span>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 leading-none">Status</p>
                    <p class="font-headline text-sm font-bold text-white" id="aidSystemStatus">Stable</p>
                  </div>
                </div>

                <div class="h-8 w-px bg-white/10"></div>

                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-primary">memory</span>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500 leading-none">CPU</p>
