  switchMode(getInitialScene(), { syncBackend: false, renderLocal: false });
  renderTranslationStream();
  renderEyeActivity();
  renderRecordLogs();
  previewRecordLabel();
  startDemoSession({ silent: true });
  if (bridgeCapable) {
    void attemptBridgeBootstrap();
  }
}

