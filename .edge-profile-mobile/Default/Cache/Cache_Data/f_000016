  on(ui.startSessionBtn, "click", async () => {
    if (canUseBridge()) {
      await apiRequest("/api/session/start", { method: "POST", body: JSON.stringify({ mode: state.activeMode }) });
      return;
    }
    startDemoSession();
  });

  on(ui.stopSessionBtn, "click", async () => {
